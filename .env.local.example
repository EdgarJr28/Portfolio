# ─── Spotify API ────────────────────────────────────────────────────────────────
# Obtener en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Flujo OAuth: ver README — necesitas el refresh_token del Authorization Code Flow
SPOTIFY_REFRESH_TOKEN=

# ─── SMTP (formulario de contacto) ──────────────────────────────────────────────
# Gmail: usa una App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=
# Dirección donde recibirás los mensajes del formulario
CONTACT_TO=tu@gmail.com
